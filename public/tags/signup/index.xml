 &amp;lt;option value=&amp;quot;coburg&amp;quot;&amp;gt;Coburg&amp;lt;/option&amp;gt;
 &amp;lt;option value=&amp;quot;cremorne&amp;quot;&amp;gt;Cremorne&amp;lt;/option&amp;gt;
 &amp;lt;option value=&amp;quot;preston&amp;quot;&amp;gt;Preston&amp;lt;/option&amp;gt;
