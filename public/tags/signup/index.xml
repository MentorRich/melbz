 &amp;lt;optgroup label=&amp;quot;Inner West&amp;quot;&amp;gt;
 &amp;lt;option value=&amp;quot;footscray&amp;quot;&amp;gt;Footscray&amp;lt;/option&amp;gt;
 &amp;lt;option value=&amp;quot;seddon&amp;quot;&amp;gt;Seddon&amp;lt;/option&amp;gt;
 &amp;lt;option value=&amp;quot;kensington&amp;quot;&amp;gt;Kensington&amp;lt;/option&amp;gt;
 &amp;lt;option value=&amp;quot;west-melbourne&amp;quot;&amp;gt;West Melbourne&amp;lt;/option&amp;gt;
 &amp;lt;/optgroup&amp;gt;
